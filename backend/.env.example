# Copy to .env for local development. This file lists variable names only.
# Never commit real values.

ENVIRONMENT=local

DATABASE_URL=sqlite+aiosqlite:///./school_learning.db
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# Required outside local and test environments. Use a long random value.
JWT_SIGNING_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
ISSUER=school-learning

# Comma-separated allowed origins. Leave empty to disable CORS.
CORS_ORIGINS=

# Used from Phase 3 onward. Not required yet.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

FREE_MODE=true
BILLING_ENABLED=false

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
PASSWORD_RESET_RATE_LIMIT_ATTEMPTS=3
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900